{
  "name": "numeria",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm test && GITHUB_PAGES=1 npm run build && gh-pages -d dist",
    "build:portail": "tsc && vite build --config vite.portal.config.ts",
    "watch:portail": "vite build --config vite.portal.config.ts --watch"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@fontsource/andika": "^5.3.0"
  }
}
