<%# Résultats d'un profil : par jeu, puis derniers essais. locals: summary, recent %>
<% if summary.empty? %>
  <p class="muted">Aucune partie jouée pour l’instant.</p>
<% else %>
  <table class="table">
    <thead><tr><th>Jeu</th><th>Essais</th><th>Réussite</th><th>Dernière partie</th></tr></thead>
    <tbody>
      <% summary.sort_by { |s| s[:last_at].to_s }.reverse_each do |s| %>
        <tr><td><%= game_title(s[:slug]) %></td><td><%= s[:total] %></td><td><%= rate_badge(s[:rate]) %></td><td><%= l(s[:last_at].to_time.in_time_zone, format: :short) if s[:last_at] %></td></tr>
      <% end %>
    </tbody>
  </table>
  <details class="recent">
    <summary>Derniers essais</summary>
    <table class="table compact">
      <thead><tr><th>Date</th><th>Jeu</th><th>Niv.</th><th>Item</th><th></th><th>Temps</th><th>Lieu</th></tr></thead>
      <tbody>
        <% recent.each do |a| %>
          <tr>
            <td><%= l(a.created_at, format: :short) %></td><td><%= game_title(a.game_slug) %></td><td><%= a.level %></td>
            <td><%= a.item %><% if a.detail %> <small class="muted">(<%= a.detail %>)</small><% end %></td>
            <td><%= a.correct ? "✅" : "❌" %></td><td><%= a.ms ? "#{(a.ms / 1000.0).round(1)} s" : "" %></td><td><%= a.mode == "seance" ? "séance" : "maison" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </details>
<% end %>
