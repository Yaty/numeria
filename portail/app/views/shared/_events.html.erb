<% labels = { "connexion" => "Connexion", "echec" => "Échec de connexion", "deconnexion" => "Déconnexion", "evince" => "Appareil déconnecté (limite)", "expire" => "Session expirée", "suspendu" => "Compte suspendu" } %>
<table class="table compact">
  <thead><tr><th>Date</th><th>Évènement</th><th>Adresse IP</th><th>Navigateur</th></tr></thead>
  <tbody>
    <% events.each do |e| %>
      <tr><td><%= l(e.created_at, format: :short) %></td><td><%= labels[e.kind] || e.kind %></td><td><%= e.ip_address %></td><td><small><%= e.user_agent.to_s.truncate(70) %></small></td></tr>
    <% end %>
  </tbody>
</table>
