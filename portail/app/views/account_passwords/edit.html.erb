<% content_for :title, "Mot de passe" %>
<div class="card narrow">
  <h1>Changer mon mot de passe</h1>
  <%= form_with url: mot_de_passe_path, method: :patch, class: "form" do |f| %>
    <label>Mot de passe actuel <%= f.password_field :current_password, required: true, autocomplete: "current-password" %></label>
    <label>Nouveau mot de passe (10 caractères minimum) <%= f.password_field :password, required: true, minlength: 10, maxlength: 72, autocomplete: "new-password" %></label>
    <label>Confirmation <%= f.password_field :password_confirmation, required: true, maxlength: 72, autocomplete: "new-password" %></label>
    <%= f.submit "Enregistrer", class: "btn primary" %>
  <% end %>
</div>
